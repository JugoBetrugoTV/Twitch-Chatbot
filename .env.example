# Twitch Bot Configuration
# Get your OAuth token from: https://twitchapps.com/tmi/
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_OAUTH_TOKEN=oauth:your_token_here
TWITCH_CHANNEL=your_channel_name

# Twitch API (for viewer list, etc.)
# Create an app at: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret

# Web Dashboard
WEB_PORT=3000
WEB_SECRET=your_secret_key_for_dashboard

# Text-to-Speech Settings
TTS_ENABLED=true
TTS_LANGUAGE=de
TTS_SPEED=1.0
TTS_VOLUME=0.8

# Song Request Settings
SONGREQUEST_ENABLED=true
SONGREQUEST_MAX_DURATION=600
SONGREQUEST_MAX_QUEUE=50

# Bot Command Prefix
COMMAND_PREFIX=!
