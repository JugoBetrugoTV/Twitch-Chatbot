{
  "name": "streamcore",
  "version": "2.0.0",
  "description": "Next-gen modular Twitch chatbot - better than Streamlabs, Nightbot & MixItUp combined",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "dev:watch": "tsc -w & nodemon dist/index.js",
    "electron": "tsc && electron .",
    "electron:dev": "tsc && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "precommit": "npm run lint && npm run format:check && npm run test"
  },
  "build": {
    "appId": "com.twitchbot.app",
    "productName": "Twitch Chatbot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "app/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "twitch",
    "chatbot",
    "tts",
    "songrequest",
    "streaming",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "tmi.js": "^1.8.5",
    "dotenv": "^16.3.1",
    "google-tts-api": "^2.0.2",
    "ytdl-core": "^4.11.5",
    "ytsr": "^3.8.4",
    "axios": "^1.6.2",
    "uuid": "^9.0.1",
    "electron-store": "^8.1.0",
    "sql.js": "^1.10.0",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "cors": "^2.8.5",
    "obs-websocket-js": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tmi.js": "^1.8.6",
    "@types/uuid": "^9.0.7",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
