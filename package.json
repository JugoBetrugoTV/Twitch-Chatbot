{
  "name": "streamcore",
  "version": "2.0.0",
  "description": "Next-gen modular Twitch chatbot - better than Streamlabs, Nightbot & MixItUp combined",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "dev:watch": "tsc -w & nodemon dist/index.js",
    "electron": "tsc && electron .",
    "electron:dev": "tsc && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.twitchbot.app",
    "productName": "Twitch Chatbot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "app/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "twitch",
    "chatbot",
    "tts",
    "songrequest",
    "streaming",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "tmi.js": "^1.8.5",
    "dotenv": "^16.3.1",
    "google-tts-api": "^2.0.2",
    "ytdl-core": "^4.11.5",
    "ytsr": "^3.8.4",
    "axios": "^1.6.2",
    "uuid": "^9.0.1",
    "electron-store": "^8.1.0",
    "better-sqlite3": "^9.2.2",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "cors": "^2.8.5",
    "obs-websocket-js": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tmi.js": "^1.8.6",
    "@types/uuid": "^9.0.7",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
